# -----------------------------------------------
# docker-mailserver environment configuration
# Docs: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/
# -----------------------------------------------

# ---- General ----
POSTFIX_MESSAGE_SIZE_LIMIT=10240000
ONE_DIR=1
TZ=America/Los_Angeles

# ---- SSL/TLS ----
# Options: letsencrypt | custom | manual | self-signed | ''
SSL_TYPE=letsencrypt
# Set these when SSL_TYPE=letsencrypt:
SSL_CERT_PATH=/etc/letsencrypt/live/mail.x-ceed.net/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/mail.x-ceed.net/privkey.pem

# ---- Anti-spam / Anti-virus ----
ENABLE_CLAMAV=1
ENABLE_SPAMASSASSIN=1
SPAMASSASSIN_SPAM_TO_INBOX=1
ENABLE_POSTGREY=1
POSTGREY_DELAY=300
POSTGREY_MAX_AGE=35
POSTGREY_AUTO_WHITELIST_CLIENTS=5
POSTGREY_TEXT=Delayed by Postgrey

# ---- Features ----
ENABLE_MANAGESIEVE=1
ENABLE_FAIL2BAN=0

# ---- Fetchmail ----
FETCHMAIL_POLL=300
