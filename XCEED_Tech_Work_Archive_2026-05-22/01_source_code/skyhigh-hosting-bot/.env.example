# License token — get this from your license provider
# Generate in the license manager: node src/cli.js create -c "YourName" -p "Skyhigh Bot" --days 30 --server-id YOUR_GUILD_ID
LICENSE_TOKEN=your_license_token_here

# Discord Bot Token (from Discord Developer Portal)
BOT_TOKEN=your_bot_token_here

# Bot Application Client ID
CLIENT_ID=your_client_id_here

# Guild ID (your Discord server ID — used for guild-scoped command deploy)
GUILD_ID=your_guild_id_here

# MySQL Database (when using docker-compose, DB_HOST=db and DB_PORT=3306)
DB_HOST=db
DB_PORT=3306
DB_USER=botuser
DB_PASSWORD=your_db_password
DB_ROOT_PASSWORD=your_db_root_password
DB_NAME=skyhigh_bot

# Health endpoint port (must not conflict with other containers)
HEALTH_PORT=3002

# ── Dashboard (Dev Portal) ────────────────────────────────────────────────────
# OAuth2 Client Secret — from Discord Developer Portal → OAuth2 tab
DISCORD_CLIENT_SECRET=your_client_secret_here

# Random secret for session encryption — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_random_string

# Comma-separated Discord User IDs allowed to access the dashboard (leave empty to allow all)
DASHBOARD_ADMIN_IDS=your_discord_user_id_here

# ── Optional integrations ─────────────────────────────────────────────────────
# Nextdactyl coin economy integration — set matching values in nextdactyl config.env
# NEXTDACTYL_URL=http://nextdactyl:53135
# NEXTDACTYL_SYNC_SECRET=your_shared_secret_here

# Payment / billing portal URL (sent to users in DMs after account link)
# PORTAL_BASE_URL=http://107.223.74.163:3010

